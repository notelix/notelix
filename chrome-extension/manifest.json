{
  "name": "notelix",
  "version": "0.1.9",
  "description": "A Note and Highlighting Tool for the Web",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Options",
    "default_popup": "extension-options.html"
  },
  "background": {
    "service_worker": "dist/background.dist.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*/*.txt"
      ],
      "js": [
        "dist/content-script.dist.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["style/extension.css", "script/extension.js"],
      "matches": ["https://example.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
