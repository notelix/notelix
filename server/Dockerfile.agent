FROM node:22.23.2-alpine3.24 AS build

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive

COPY nest-cli.json tsconfig.json tsconfig.build.json ormconfig.js ./
COPY src ./src
RUN yarn build

FROM node:22.23.2-alpine3.24 AS production-dependencies

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive --production \
  && yarn cache clean

FROM node:22.23.2-alpine3.24 AS runtime

ENV NODE_ENV=production \
  RUN_MODE=AGENT
WORKDIR /app

COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ormconfig.js ./
COPY --chown=node:node tools/ensure-pg-db.js tools/meili-reindex.js tools/run-migrations.js ./tools/

RUN mkdir -p /data && chown node:node /data

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/meta/version').then((response) => { if (!response.ok) process.exit(1) }).catch(() => process.exit(1))"

CMD ["npm", "run", "prod"]
