DB_PASSWORD=replace-with-a-random-secret
DB_ADMIN_DATABASE=postgres
DB_AUTO_CREATE=true
DB_CONNECT_TIMEOUT_MS=120000
DB_CONNECT_RETRY_INTERVAL_MS=1000
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=60000
DB_MIGRATION_LOCK_TIMEOUT_MS=120000
MEILI_MASTER_KEY=replace-with-another-random-secret
AGENT_CONTROL_ORIGINS=chrome-extension://replace-with-your-notelix-extension-id
MEILISEARCH_REQUEST_TIMEOUT_MS=10000
MEILISEARCH_TASK_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT_BYTES=1048576
STATIC_TOKEN_AUTO_PROVISION=false
STATIC_TOKEN_AUTO_PROVISION_LIMIT=1000
AGENT_SYNC_REQUEST_TIMEOUT_MS=30000
AGENT_SYNC_MAX_RESPONSE_BYTES=67108864
AGENT_SYNC_MAX_DIFF_PAGES_PER_CYCLE=10
AGENT_SYNC_MAX_SNAPSHOT_PAGES_PER_CYCLE=10
