{
  "name": "server",
  "description": "",
  "author": "",
  "private": true,
  "scripts": {
    "schema:sync": "nest build && typeorm schema:sync",
    "schema:sync:compiled": "typeorm schema:sync",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node ./tools/ensure-pg-db.js && npm run schema:sync && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prod": "node ./tools/ensure-pg-db.js && npm run schema:sync:compiled && npm run start:prod",
    "meili:reindex": "node ./tools/meili-reindex.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "bash ./tools/test-local-stack.sh"
  },
  "dependencies": {
    "@nestjs/common": "^8.0.0",
    "@nestjs/core": "^8.0.0",
    "@nestjs/platform-express": "^8.0.0",
    "bcrypt": "^6.0.0",
    "crypto-js": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "^0.24.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.7.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "typeorm": "^0.2.34"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.0.0",
    "@nestjs/schematics": "^8.0.0",
    "@nestjs/testing": "^8.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.0.0",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^4.28.2",
    "@typescript-eslint/parser": "^4.28.2",
    "eslint": "^7.30.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "jest": "27.0.6",
    "prettier": "^2.3.2",
    "rimraf": "^6.1.3",
    "supertest": "^6.1.3",
    "ts-node": "^10.0.0",
    "ts-jest": "^27.1.5",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  }
}
