{
  "name": "server",
  "description": "",
  "author": "",
  "private": true,
  "scripts": {
    "schema:sync": "nest build && npm run schema:sync:compiled",
    "schema:sync:compiled": "typeorm schema:sync -d dist/database.js",
    "migration:run": "nest build && npm run migration:run:compiled",
    "migration:run:compiled": "node ./tools/run-migrations.js",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node ./tools/ensure-pg-db.js && npm run schema:sync && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prod": "node ./tools/ensure-pg-db.js && npm run migration:run:compiled && npm run start:prod",
    "meili:reindex": "node ./tools/meili-reindex.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:compose": "bash ./tools/test-compose-config.sh",
    "test:integration": "bash ./tools/test-local-stack.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto-js": "^4.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "0.56.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^7.30.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^3.4.0",
    "jest": "^29.7.0",
    "prettier": "^2.3.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.0.0",
    "ts-jest": "^29.4.1",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.9.5"
  }
}
