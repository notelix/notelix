FROM node:26.8.1-alpine3.24 AS extension-build

WORKDIR /extension

COPY chrome-extension/package.json chrome-extension/yarn.lock ./
RUN npx --yes yarn@1.22.22 install --frozen-lockfile --non-interactive

COPY chrome-extension/babel.config.js chrome-extension/webpack.config.js chrome-extension/webpack.content-script.config.js ./
COPY chrome-extension/src ./src
RUN npx --yes yarn@1.22.22 build:content-script

FROM node:26.8.1-alpine3.24 AS build

WORKDIR /app

COPY server/package.json server/yarn.lock ./
RUN npx --yes yarn@1.22.22 install --frozen-lockfile --non-interactive

COPY server/nest-cli.json server/tsconfig.json server/tsconfig.build.json server/ormconfig.js server/runtime-config.js server/runtime-config.d.ts ./
COPY server/src ./src
RUN npx --yes yarn@1.22.22 build

FROM node:26.8.1-alpine3.24 AS production-dependencies

WORKDIR /app

COPY server/package.json server/yarn.lock ./
RUN npx --yes yarn@1.22.22 install --frozen-lockfile --non-interactive --production \
  && npx --yes yarn@1.22.22 cache clean

FROM node:26.8.1-alpine3.24 AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node server/package.json server/ormconfig.js server/runtime-config.js ./
COPY --chown=node:node server/tools/ensure-pg-db.js server/tools/meili-reindex.js server/tools/start-production.sh ./tools/
COPY --chown=node:node server/public ./public
COPY --from=extension-build --chown=node:node /extension/dist/content-script.dist.js ./public/embedded/content-script.dist.js

RUN mkdir -p /data && chown node:node /data

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/meta/ready').then((response) => { if (!response.ok) process.exit(1) }).catch(() => process.exit(1))"

CMD ["sh", "./tools/start-production.sh"]
